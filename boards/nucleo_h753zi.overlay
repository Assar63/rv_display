/*
 * GDEM075F52 (Good Display, 7.5" 800x480 e-paper, UC8179 controller)
 * wired to the Nucleo-H753ZI Arduino R3 header:
 *
 *   SPI1   MOSI=PB5  MISO=PA6  SCK=PA5  CS=PD14   (D11/D12/D13/D10)
 *   DC     PD15  (D9)
 *   RST    PF3   (D8)
 *   BUSY   PG12  (D7)
 *
 * Softstart / CDI / TCON values borrowed from the Waveshare GDEW075T7 shield;
 * the panel format and controller are identical, so they are a sane starting
 * point and can be tuned per panel later.
 */

#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>

/ {
	chosen {
		zephyr,display = &epd_gdem075f52;
	};

	mipi_dbi_epd: mipi_dbi_epd {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&arduino_spi>;
		dc-gpios = <&arduino_header ARDUINO_HEADER_R3_D9 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&arduino_header ARDUINO_HEADER_R3_D8 GPIO_ACTIVE_LOW>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		epd_gdem075f52: uc8179@0 {
			compatible = "ultrachip,uc8179";
			mipi-max-frequency = <4000000>;
			reg = <0>;
			width = <800>;
			height = <480>;
			busy-gpios = <&arduino_header ARDUINO_HEADER_R3_D7 GPIO_ACTIVE_LOW>;

			softstart = [17 17 17 17];

			full {
				pwr = [07 07 3f 3f];
				cdi = <07>;
				tcon = <0x22>;
			};
		};
	};
};
